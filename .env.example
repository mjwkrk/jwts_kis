# 복사해서 .env 로 쓴다. .env 는 절대 커밋하지 않는다.
#
# ★ 두 계정이 모두 필요하다 (README의 "계정 구성" 참조)
#   - 실전 계정: 시세·차트·순위 조회 전용 (주문 없음)
#   - 모의 계정: 주문 집행 전용

# 실전 계정 — 시세 조회에만 사용
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_CANO=

# 모의투자 계정 — 주문 집행에 사용
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_CANO=

# 선택 — 알림 (notify/ 미구현)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
